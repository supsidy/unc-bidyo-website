# Copy this file to .env and fill in real values.
# EmailJS — all three of these are PUBLIC identifiers, safe to expose in a client bundle.
# Get them from https://dashboard.emailjs.com after completing the setup steps.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
